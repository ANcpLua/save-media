{
  "name": "@savemedia/extension",
  "version": "1.0.4",
  "private": true,
  "description": "savemedia browser extension package for Chrome, Edge, and Firefox Desktop.",
  "license": "Apache-2.0",
  "author": "Alexander Nachtmann ANcpLua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANcpLua/save-media.git",
    "directory": "packages/extension"
  },
  "type": "module",
  "scripts": {
    "build": "node scripts/build-chrome.mjs",
    "build:chrome": "node scripts/build-chrome.mjs",
    "build:firefox": "node scripts/build-firefox.mjs",
    "build:all": "bun run build:chrome && bun run build:firefox",
    "zip": "bun run build:all && node scripts/package.mjs",
    "dev": "SAVEMEDIA_BROWSER=chromium vite build --watch",
    "icons": "node scripts/generate-icons.mjs",
    "store:assets": "node scripts/store-assets.mjs",
    "lint:firefox": "bun run build:firefox && web-ext lint --source-dir dist-firefox",
    "smoke:edge": "bun run build:chrome && node scripts/smoke-edge.mjs",
    "smoke:firefox": "bun run build:firefox && node scripts/smoke-firefox.mjs",
    "screenshots": "node scripts/screenshot/capture.mjs",
    "lint": "bun run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun run test:e2e:chromium",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox-fixtures": "playwright test --project=firefox-fixtures",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "report:e2e": "playwright show-report playwright-report",
    "typecheck": "tsc -p tsconfig.json",
    "smoke:native": "bun run build:chrome && node scripts/smoke-native.mjs"
  },
  "dependencies": {
    "@savemedia/core": "workspace:*",
    "m3u8-parser": "^7.2.0",
    "mediabunny": "^1.61.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.6.1",
    "jsdom": "30.1.2",
    "postcss": "8.5.29",
    "selenium-webdriver": "4.51.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "web-ext": "10.7.0"
  }
}
