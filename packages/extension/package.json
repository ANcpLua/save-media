{
  "name": "@savemedia/extension",
  "version": "1.0.6",
  "private": true,
  "description": "savemedia browser extension package for Chrome, Edge, and Firefox Desktop.",
  "license": "Apache-2.0",
  "author": "Alexander Nachtmann ANcpLua",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ANcpLua/save-media.git",
    "directory": "packages/extension"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build-chrome.mjs",
    "build:chrome": "bun scripts/build-chrome.mjs",
    "build:preview": "bun scripts/build-chrome.mjs --preview",
    "build:firefox": "bun scripts/build-firefox.mjs",
    "build:all": "bun run build:chrome && bun run build:firefox",
    "zip": "SAVEMEDIA_STORE_BUILD=1 bun run build:all && bun scripts/package.mjs",
    "icons": "bun scripts/generate-icons.mjs",
    "store:assets": "bun scripts/store-assets.mjs",
    "lint:firefox": "bun run build:firefox && bun --bun web-ext lint --source-dir dist-firefox",
    "smoke:edge": "bun run build:chrome && bun scripts/smoke-edge.mjs",
    "smoke:firefox": "bun run build:firefox && bun scripts/smoke-firefox.mjs",
    "screenshots": "bun scripts/screenshot/capture.mjs",
    "lint": "bun run typecheck",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:e2e": "bun run test:e2e:chromium",
    "test:e2e:chromium": "bun --bun playwright test --project=chromium",
    "test:e2e:firefox-fixtures": "bun --bun playwright test --project=firefox-fixtures",
    "test:e2e:headed": "SAVEMEDIA_HEADED=1 bun --bun playwright test --project=chromium --headed",
    "report:e2e": "bun --bun playwright show-report playwright-report",
    "typecheck": "bun --bun tsc -p tsconfig.json",
    "smoke:native": "bun run build:chrome && bun scripts/smoke-native.mjs"
  },
  "dependencies": {
    "@savemedia/core": "workspace:*",
    "m3u8-parser": "^7.2.1",
    "mediabunny": "^1.66.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "22.19.19",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.7.0",
    "jsdom": "25.0.1",
    "postcss": "8.5.33",
    "selenium-webdriver": "4.53.0",
    "tailwindcss": "3.4.19",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "web-ext": "10.8.0"
  }
}
