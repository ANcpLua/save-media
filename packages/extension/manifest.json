{
  "manifest_version": 3,
  "name": "savemedia",
  "version": "1.0.5",
  "description": "Saves videos and images that are not DRM encrypted, as your browser receives them, and checks each file it downloads itself.",
  "minimum_chrome_version": "114",
  "incognito": "not_allowed",
  "permissions": [
    "downloads",
    "tabs",
    "offscreen",
    "webRequest",
    "webNavigation",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "src/popup/index.html",
    "default_title": "savemedia"
  },
  "commands": {
    "download-best": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "Alt+S"
      },
      "description": "Save the video or image under the pointer, or the main video of the page"
    }
  },
  "optional_permissions": [
    "nativeMessaging"
  ]
}
